# --- Model provider (pick one; default is local & free) ---
# ollama     -> local Ollama (default). Zero cost. Requires `ollama serve` + a pulled model.
# openrouter -> OpenRouter via LiteLLM. Requires OPENROUTER_API_KEY.
# demo       -> built-in scripted model + fixture issues. Fully offline, for the demo video.
TRIAGEPILOT_PROVIDER=ollama

# Model id for the chosen provider (examples):
#   ollama:     qwen2.5 / llama3.1 / mistral
#   openrouter: qwen/qwen-2.5-72b-instruct / meta-llama/llama-3.3-70b-instruct
TRIAGEPILOT_MODEL=qwen2.5
OLLAMA_HOST=http://localhost:11434

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# --- GitHub ---
# Optional for public repos (60 req/hr unauthenticated). Needed for private repos
# and for --apply (actually writing labels/comments).
GITHUB_TOKEN=

# Safety: triagepilot never writes to GitHub unless --apply is passed AND a token is set.
